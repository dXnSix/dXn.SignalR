---
import '../styles/global.css';
import '../styles/landing.css';
import { SITE_URL } from '../lib/site';
import { library } from '../lib/docs';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
}

const SITE_TITLE = library.name;
const { title, description = `${library.name} documentation`, canonical = new URL(Astro.url.pathname, SITE_URL).href, robots } = Astro.props;
const pageTitle = !title || title === SITE_TITLE ? SITE_TITLE : title.includes(SITE_TITLE) ? title : `${title} · ${SITE_TITLE}`;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <title>{pageTitle}</title>
    <link rel="icon" href={`${base}logo.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Theme: apply before paint to avoid a flash -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var system = window.matchMedia('(prefers-color-scheme: dark)');
        document.documentElement.classList.toggle('dark', stored === 'dark' || (!stored && system.matches));
        system.addEventListener('change', function (event) {
          var saved = null;
          try { saved = localStorage.getItem('theme'); } catch (e) {}
          if (!saved) document.documentElement.classList.toggle('dark', event.matches);
        });
      })();
    </script>

    <!-- Favicon follows the theme -->
    <script is:inline define:vars={{ base }}>
      (function () {
        function update() {
          var dark = document.documentElement.classList.contains('dark');
          var link = document.querySelector('link[rel="icon"]');
          if (link) link.href = base + (dark ? 'logo-dark.svg' : 'logo.svg');
        }
        update();
        new MutationObserver(update).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Diagrams are rendered in the browser, and only on pages that have one:
      // Mermaid is a large dependency. They re-render when the color theme changes.
      const nodes = [...document.querySelectorAll<HTMLElement>('.mermaid')];
      if (nodes.length > 0) {
        for (const node of nodes) node.dataset.source = node.textContent ?? '';

        const token = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

        async function render() {
          const { default: mermaid } = await import('mermaid');
          const dark = document.documentElement.classList.contains('dark');
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            theme: 'base',
            fontFamily: token('--font-sans'),
            flowchart: { curve: 'basis', padding: 12, wrappingWidth: 420 },
            themeVariables: {
              darkMode: dark,
              background: token('--background'),
              fontSize: '14px',
              primaryColor: token('--secondary'),
              primaryTextColor: token('--foreground'),
              primaryBorderColor: token('--muted-foreground'),
              secondaryColor: token('--secondary'),
              tertiaryColor: token('--background'),
              lineColor: token('--muted-foreground'),
              textColor: token('--foreground'),
              mainBkg: token('--secondary'),
              nodeBorder: token('--muted-foreground'),
              clusterBkg: token('--background'),
              clusterBorder: token('--border'),
              edgeLabelBackground: token('--background'),
              titleColor: token('--foreground'),
            },
          });
          for (const node of nodes) {
            node.removeAttribute('data-processed');
            node.textContent = node.dataset.source ?? '';
          }
          await mermaid.run({ nodes });
        }

        render();
        new MutationObserver(() => render()).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
      }
    </script>
  </body>
</html>
