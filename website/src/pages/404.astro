---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." robots="noindex, nofollow">
  <Nav currentPath="/404" />
  <main style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:calc(100vh - 3.5rem);padding:2rem;text-align:center;gap:1.25rem;">
    <h1 style="margin:0;font-size:clamp(3rem,8vw,6rem);font-weight:700;letter-spacing:-0.06em;line-height:1;">404</h1>
    <p style="margin:0;max-width:34rem;font-size:1.1rem;color:var(--muted-foreground);">The page you are looking for does not exist.</p>
    <a class="btn btn--primary" href={base}>Go home</a>
  </main>
</BaseLayout>
