---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { loadDocs, library, docRoute } from '../../lib/docs';

export async function getStaticPaths() {
  const { pages, sidebar } = await loadDocs();
  return pages.map((entry, index) => {
    const prev = pages[index - 1];
    const next = pages[index + 1];
    return {
      params: { slug: entry.id.replace(/^docs\//, '') },
      props: {
        entry,
        sidebar,
        prev: prev && { text: prev.data.title, link: docRoute(prev) },
        next: next && { text: next.data.title, link: docRoute(next) },
      },
    };
  });
}

const { entry, sidebar, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sidebar={sidebar}
  headings={headings}
  kicker={entry.data.group ? `${library.name} · ${entry.data.group}` : library.name}
  prev={prev}
  next={next}
>
  <h1>{entry.data.title}</h1>
  <p class="doc-description">{entry.data.description}</p>
  <Content />
</DocsLayout>
