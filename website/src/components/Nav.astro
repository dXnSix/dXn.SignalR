---
import DocSearch from './DocSearch.astro';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import { libraries } from '../lib/libraries';
import { library } from '../lib/docs';

export interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const url = (path: string) => `${base}${path}`.replace(/\/+/g, '/');
const path = currentPath.replace(/\/+$/, '') || '/';

const navLinks = [
  { text: 'Overview', href: base, active: path === base.replace(/\/+$/, '') || path === '/' },
  { text: 'Docs', href: url('docs/getting-started'), active: path.startsWith(url('docs')) },
];

const resourceLinks = [
  ...(library.apiDocs ? [{ text: 'API reference (docs.rs)', href: library.apiDocs }] : []),
  { text: 'Source on GitHub', href: library.repo },
  { text: 'Issues', href: `${library.repo}/issues` },
  { text: 'Releases', href: `${library.repo}/releases` },
  { text: 'Changelog', href: `${library.repo}/blob/${library.branch}/CHANGELOG.md` },
];
---

<nav class="site-nav" aria-label="Primary">
  <div class="site-nav__inner">
    <a href={base} class="site-nav__brand">
      <Logo />
      <span>{library.name}</span>
    </a>

    <details class="site-nav__projects">
      <summary aria-label="Switch library" title="Switch library">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="site-nav__projects-menu">
        {libraries.map((lib) => {
          const isCurrent = lib.id === library.id;
          return (
            <a
              href={isCurrent ? base : lib.site}
              class:list={{ 'is-current': isCurrent }}
              aria-current={isCurrent ? 'true' : undefined}
              target={isCurrent ? undefined : '_blank'}
              rel={isCurrent ? undefined : 'noopener noreferrer'}
            >
              <Logo class="site-nav__logo site-nav__project-logo" />
              <div class="site-nav__project-copy">
                <strong>{lib.name}</strong>
                <span>{lib.summary}</span>
              </div>
            </a>
          );
        })}
      </div>
    </details>

    <div class="site-nav__links" id="site-nav-links">
      {navLinks.map((link) => (
        <a href={link.href} class:list={['site-nav__link', { active: link.active }]}>{link.text}</a>
      ))}

      <div class="site-nav__dropdown">
        <button class="site-nav__dropdown-btn site-nav__link" type="button" aria-haspopup="true" aria-expanded="false">
          Resources
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="site-nav__dropdown-menu">
          {resourceLinks.map((link) => (
            <a href={link.href} class="site-nav__dropdown-item" target="_blank" rel="noopener noreferrer">{link.text}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="site-nav__actions">
      <DocSearch />

      <a href={library.repo} target="_blank" rel="noopener noreferrer" class="github-link site-nav__link" title="GitHub" aria-label="GitHub">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
          <path d="M9 18c-4.51 2-5-2-7-2"/>
        </svg>
      </a>

      <ThemeToggle />

      <button id="nav-burger" class="site-nav__burger" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav-links" type="button">
        <svg class="site-nav__burger-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg class="site-nav__burger-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
  </div>
</nav>

<script>
  const projects = document.querySelector<HTMLDetailsElement>('.site-nav__projects');
  document.addEventListener('click', (event) => {
    if (projects?.open && !projects.contains(event.target as Node)) projects.open = false;
  });
  projects?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    projects.open = false;
    projects.querySelector('summary')?.focus();
  });

  // Visibility is owned by CSS (`:hover`, `:focus-within`), so `aria-expanded`
  // is derived from the element. Escape adds the one state CSS cannot express.
  document.querySelectorAll<HTMLElement>('.site-nav__dropdown').forEach((group) => {
    const btn = group.querySelector<HTMLButtonElement>('.site-nav__dropdown-btn');
    if (!btn) return;
    const sync = () => {
      const open = !group.classList.contains('is-dismissed') && group.matches(':hover, :focus-within');
      btn.setAttribute('aria-expanded', String(open));
    };
    for (const event of ['pointerenter', 'focusin']) group.addEventListener(event, () => requestAnimationFrame(sync));
    group.addEventListener('pointerleave', () => { group.classList.remove('is-dismissed'); requestAnimationFrame(sync); });
    group.addEventListener('focusout', (event) => {
      if (!group.contains(event.relatedTarget as Node)) group.classList.remove('is-dismissed');
      requestAnimationFrame(sync);
    });
    group.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      group.classList.add('is-dismissed');
      btn.focus();
      sync();
    });
  });

  const burger = document.getElementById('nav-burger');
  const navLinksEl = document.getElementById('site-nav-links');
  const openIcon = burger?.querySelector<HTMLElement>('.site-nav__burger-open');
  const closeIcon = burger?.querySelector<HTMLElement>('.site-nav__burger-close');
  function setNavOpen(open: boolean) {
    navLinksEl?.classList.toggle('is-open', open);
    burger?.setAttribute('aria-expanded', String(open));
    if (openIcon) openIcon.style.display = open ? 'none' : '';
    if (closeIcon) closeIcon.style.display = open ? '' : 'none';
  }
  burger?.addEventListener('click', () => setNavOpen(!navLinksEl?.classList.contains('is-open')));
  navLinksEl?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setNavOpen(false); });
</script>

<style>
.site-nav__actions .site-nav__link { height: 2rem; padding-block: 0; }
.site-nav__actions svg { display: block; flex-shrink: 0; }
.github-link { display: inline-flex; align-items: center; }

.site-nav__burger {
  display: none;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: var(--radius-control);
  color: var(--foreground);
  background: transparent;
  cursor: pointer;
}
.site-nav__burger:hover { background: var(--secondary); }

@media (max-width: 900px) {
  .site-nav__burger { display: inline-flex; }
  .site-nav__links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: stretch;
    gap: 0.15rem;
    padding: 0.5rem 1.5rem 0.85rem;
    border-top: 1px solid var(--border);
    background: var(--background);
    box-shadow: var(--shadow-panel);
  }
  .site-nav__links.is-open { display: flex; }
  .site-nav__link { height: auto; padding: 0.65rem 0; }
  .site-nav__dropdown { position: static; }
  .site-nav__dropdown-menu {
    position: static;
    display: flex;
    flex-direction: column;
    margin-left: 0.85rem;
    padding: 0;
    border: none;
    box-shadow: none;
    background: none;
    opacity: 1;
    visibility: visible;
  }
}
</style>
