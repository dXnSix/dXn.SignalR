<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- The source-generated WinINet interop of the os-proxy runner (Scenarios/SystemProxy.cs). -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>RayX.SignalR.E2E.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.Testing" Version="13.5.3"/>
        <!-- Aspire's StreamJsonRpc still asks for MessagePack 2.5.302 (GHSA-qhrr-8q5h-9q3h); 2.5.303 fixes it. -->
        <PackageReference Include="MessagePack" Version="2.5.303"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../RayX.SignalR.AppHost/RayX.SignalR.AppHost.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>
</Project>
